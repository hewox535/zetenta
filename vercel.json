{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "zetenta.app" }], "dest": "/l/index.html" },
    { "src": "/", "has": [{ "type": "host", "value": "www.zetenta.app" }], "dest": "/l/index.html" },
    { "src": "/sw.js", "headers": { "cache-control": "no-cache" }, "continue": true },
    { "src": "/(assets|l/assets)/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
